int main() {
    cout << "Please enter an image file name with its suffix: " << endl;
    string og_filename;
    string new_filename;
    // const vector<vector<Pixel>> new_image;
    cin >> og_filename;
    
    vector<vector<Pixel>> image = read_image(og_filename);  // Read image file and store in 2D vector named image
    int num_rows = image.size();  // HEIGHT Gets the number of rows (i.e. height) in a 2D vector named image
    int num_columns = image[0].size();  // WIDTH Gets the number of columns (i.e. width) in a 2D vector named image

    vector<vector<Pixel>> new_image(num_rows, vector<Pixel> (num_columns));
    // removed const from infront of vector
    bool run = true; // conditional for while loop
    while(run){
        cout << "Select which image process to use or whether you would like to change the input image by entering the corresponding numerical value:" << endl << "1 - Vignette" << endl << "2 - Clarendon" << endl << "3 - Grayscale" << endl << "4 - Rotates 90 degrees clockwise" << endl << "5 - Rotates image by specified multiples of 90 degrees clockwise" << endl << "6 - Enlarges image" << endl << "7 - High contrast (black and white only)" << endl << "8 - Lightens image" << endl << "9 - Darkens image" << endl << "10 - Converts image to black, white, red, blue, and green" << endl << "11 - To change image" << endl;
        int option;
        cin >> option; // user's response to question above
        
        if (option == 11){ // if they reply with 11, ask again what the file name is
            cout << "What is the input file name with its suffix that you want to replace the previous image file?" << endl;
            cin >> og_filename; // save new file name to variable
            return 0;
        }
        
        cout << "What would you like your new file name to be with the suffix?" << endl;
        cin >> new_filename; // save new file name to variable
        
        switch (option) { // switch cases to run through the options provided above
            case 1: // Adds vignette effect to image (dark corners)
                new_image = process_1(image, num_rows, num_columns);
                //run = false;
                // vector<vector<Pixel>> process_1(const vector<vector<Pixel>>& image);
                break;
            case 2: // Adds Clarendon effect to image (darks darker and lights lighter) by a scaling factor
                cout << "How much would you like to apply the Clarendon effect?" << endl;
                double clarendon;
                cin >> clarendon;
                new_image = process_2(image, num_rows, num_columns, clarendon);
                //vector<vector<Pixel>> process_2(const vector<vector<Pixel>>& image, double scaling_factor);
                break;
            case 3: // Grayscale image
                new_image = process_3(image, num_rows, num_columns);
                // vector<vector<Pixel>> process_3(const vector<vector<Pixel>>& image);
                break;
            case 4: // Rotates image by 90 degrees clockwise (not counter-clockwise)
                new_image = process_4(image, num_rows, num_columns);
                // vector<vector<Pixel>> process_4(const vector<vector<Pixel>>& image);
                break;
            case 5: // Rotates image by a specified number of multiples of 90 degrees clockwise
                cout << "How many times would you like to rotate the image by 90 degrees clockwise?" << endl;
                int rotations;
                cin >> rotations;
                new_image = process_5(image, num_rows, num_columns, rotations);
                // vector<vector<Pixel>> process_5(const vector<vector<Pixel>>& image, int number);
                break;
            case 6: // Enlarges the image in the x and y direction
                cout << "How much would you like to enlargen the image length-wise?" << endl;
                int length;
                cin >> length;
                cout << "How much would you like to enlargen the image width-wise?" << endl;
                int width;
                cin >> width;
                new_image = process_6(image, num_rows, num_columns, length, width);
                // vector<vector<Pixel>> process_6(const vector<vector<Pixel>>& image, int x_scale, int y_scale);
                break;
            case 7: // Convert image to high contrast (black and white only)
                new_image = process_7(image, num_rows, num_columns);
                // vector<vector<Pixel>> process_7(const vector<vector<Pixel>>& image);
                break;
            case 8: // Lightens image by a scaling factor
                cout << "How much would you like to lighten your image?" << endl;
                double lighten;
                cin >> lighten;
                new_image = process_8(image, num_rows, num_columns, lighten);
                vector<vector<Pixel>> process_8(const vector<vector<Pixel>>& image, double scaling_factor);
                break;
            case 9: // Darkens image by a scaling factor
                cout << "How much would you like to darken your image?" << endl;
                double darken;
                cin >> darken;
                new_image = process_9(image, num_rows, num_columns, darken);
                // vector<vector<Pixel>> process_9(const vector<vector<Pixel>>& image, double scaling_factor);
                break;
            case 10: // Converts image to only black, white, red, blue, and green
                new_image = process_10(image, num_rows, num_columns);
                // vector<vector<Pixel>> process_10(const vector<vector<Pixel>>& image);
                break;
            default:
                break;
        }
       bool success = write_image("new_file.bmp", new_image);  // Write 2D vector named new_image to file named new_file.bmp

    }
    return 0;
}
